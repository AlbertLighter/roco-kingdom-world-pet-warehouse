# Roco Kingdom World Pet Warehouse - 环境变量模板
# 复制此文件为 .env 并填入真实凭证

# QQ 登录凭证（从 direct-login 获取）
OPENID=
ACCESS_TOKEN=
REFRESH_TOKEN=
APPID=102802421

# 可选：API 网关活动 ID（默认 E80EH8LJ）
# X_MCUBE_ACT_ID=E80EH8LJ

# 可选：关闭 SSL 验证（某些网络环境需要）
# REQUESTS_VERIFY=false

# 可选：同步线程数（增大可加快同步速度，但可能触发 API 限频，建议 ≤4）
# SYNC_WORKERS=1

# 可选：HTTP 代理
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
